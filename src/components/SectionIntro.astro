---
interface Props { label: string; title: string; description: string; glyph?: string }
const { label, title, description, glyph = '✳' } = Astro.props;
---
<header class="section-intro rise-on-scroll">
  <div class="eyebrow">{glyph} &nbsp; {label}</div>
  <h1>{title}</h1>
  <p>{description}</p>
</header>

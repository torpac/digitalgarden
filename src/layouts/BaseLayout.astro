---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GardenSidebar from '../components/GardenSidebar.astro';
import Starfield from '../components/Starfield.astro';
import '../styles/global.css';
import '../styles/custom.css';
import { site, appearance, themeStyle } from '../lib/settings';
import { mediaUrl } from '../lib/paths';
interface Props { title?: string; description?: string }
const { title, description = site.intro } = Astro.props;
const pageTitle = title ? `${title} | ${site.name.toLowerCase()}` : site.name.toLowerCase();
const favicon = mediaUrl(site.faviconImage) || `${import.meta.env.BASE_URL}favicon.svg`;
---
<!doctype html>
<html lang="en" style={themeStyle()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={appearance.colors.sky} />
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <title>{pageTitle}</title>
  </head>
  <body data-reveal={String(appearance.effects.scrollReveal)} class:list={[appearance.effects.cursorBlink ? '' : 'no-cursor-blink', appearance.layout.density] }>
    <Starfield />
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class:list={['site-frame', {'hide-sidebar': !appearance.visibility.sidebar}] }>
      <div class="window-bar"><span>{site.windowTitle}</span><span class="window-controls" aria-hidden="true">─ &nbsp; □ &nbsp; ×</span></div>
      <Header />
      <div class="page-grid">
        {appearance.visibility.sidebar && <GardenSidebar />}
        <main id="main-content"><slot /></main>
      </div>
      {appearance.visibility.footer && <Footer />}
    </div>
    <script>
      if (document.body.dataset.reveal === 'true') {
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const sections = document.querySelectorAll('.rise-on-scroll');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('has-entered');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.06 });
        sections.forEach((section) => { section.classList.add('rise-enabled'); observer.observe(section); });
      }
      }
    </script>
  </body>
</html>

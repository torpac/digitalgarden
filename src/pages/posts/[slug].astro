---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../lib/settings';
import { getCollection, render } from 'astro:content';
import { path, mediaUrl } from '../../lib/paths';
export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const img = mediaUrl(entry.data.cover);
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="detail-page shell narrow">
    <a class="back-link" href={path('/posts/')}>{copy.posts.backLabel}</a>
    <header class="detail-heading">
      <div class="eyebrow">{copy.posts.postDetailPrefix} / {entry.data.stage} / {entry.data.date.toLocaleDateString('en-GB')}</div>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p>{entry.data.description}</p>}
      <div class="detail-meta">{entry.data.tags.map((tag) => <span>#{tag}</span>)}{entry.data.example && <span>{copy.media.sampleLabel}</span>}</div>
    </header>
    {img && <img class="post-hero-cover" src={img} alt={`${entry.data.title} cover`} />}
    <div class="prose"><Content /></div>
    <footer class="detail-end">{copy.posts.postEnd} <a href={path('/posts/')}>{copy.posts.postEndLink}</a></footer>
  </article>
</BaseLayout>

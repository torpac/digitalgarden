---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../lib/settings';
import SectionIntro from '../../components/SectionIntro.astro';
import { getCollection } from 'astro:content';
import { path, mediaUrl } from '../../lib/paths';
const entries = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const stages = { seedling: copy.posts.seedlingLabel, growing: copy.posts.growingLabel, evergreen: copy.posts.evergreenLabel };
---
<BaseLayout title={copy.pages.posts.title}>
  <div class="shell content-page">
    <SectionIntro {...copy.pages.posts} />
    <div class="garden-key rise-on-scroll">
      <span>{copy.posts.seedlingLegend}</span><span>{copy.posts.growingLegend}</span><span>{copy.posts.evergreenLegend}</span>
    </div>
    <div class="post-index">
      {entries.map((entry) => {
        const img = mediaUrl(entry.data.cover);
        return <a class="post-preview rise-on-scroll" href={path(`/posts/${entry.id}/`)}>
          <div class="post-thumb">
            {img ? <img src={img} alt={`${entry.data.title} cover`} loading="lazy" /> : <span>✳<small>{copy.posts.coverPlaceholder}</small></span>}
          </div>
          <div class="post-text">
            <span class="post-date">{entry.data.date.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' })} · {stages[entry.data.stage]}</span>
            <h2>{entry.data.title}</h2>
            {entry.data.description && <p>{entry.data.description}</p>}
            <div class="tagline">{entry.data.tags.map((tag) => <span>#{tag}</span>)}{entry.data.example && <span>{copy.media.sampleLabel}</span>}</div>
          </div>
          <div class="post-arrow">↗</div>
        </a>;
      })}
      {entries.length === 0 && <p class="empty-state">{copy.posts.empty}</p>}
    </div>
  </div>
</BaseLayout>

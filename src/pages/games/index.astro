---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { copy } from '../../lib/settings';
import SectionIntro from '../../components/SectionIntro.astro';
import RankedCollection from '../../components/RankedCollection.astro';
import { getCollection } from 'astro:content';
const entries = await getCollection('games', ({ data }) => !data.draft);
---
<BaseLayout title={copy.pages.games.title}>
  <div class="shell content-page">
    <SectionIntro {...copy.pages.games} />
    <RankedCollection entries={entries} kind="games" />
  </div>
</BaseLayout>
